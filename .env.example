# BugHan configuration — copy to .env and adjust.
# docker compose up  (web applies migrations on boot)

# Required: a long random secret (e.g. `openssl rand -hex 32`)
BUGHAN_SECRET_KEY=

# Public base URL — used to build DSNs and email links
BUGHAN_URL=http://localhost:8000

# HTTP port on the host
BUGHAN_PORT=8000

# Postgres credentials (container-internal defaults are fine)
BUGHAN_DB_USER=bughan
BUGHAN_DB_PASSWORD=bughan
BUGHAN_DB_NAME=bughan

# Lock the install to a single organization (strict self-host)
BUGHAN_SINGLE_ORG=false

# Retention (days)
BUGHAN_RETENTION_EVENT_DAYS=90
BUGHAN_RETENTION_TRANSACTION_DAYS=30
BUGHAN_RETENTION_SESSION_DAYS=30
BUGHAN_RETENTION_FEEDBACK_DAYS=90

# Ingest body cap (MB, decompressed)
BUGHAN_MAX_EVENT_MB=20

# SMTP (optional — enables verification emails, invites, alert email actions)
#BUGHAN_SMTP_HOST=
#BUGHAN_SMTP_PORT=587
#BUGHAN_SMTP_USER=
#BUGHAN_SMTP_PASS=
#BUGHAN_SMTP_FROM=BugHan <bugs@example.com>
